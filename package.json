{
  "name": "afterhook",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source webhook operations platform for tracing delivery, failures, and safe retries.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "quality": "npm run format:check && npm run clean && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run test:browser",
    "test": "vitest run --passWithNoTests",
    "test:integration": "npm --workspace @afterhook/api run db:migrate && vitest --config vitest.integration.config.ts",
    "test:browser": "playwright test --config playwright.config.mjs",
    "typecheck": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
